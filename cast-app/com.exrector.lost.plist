<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Автозапуск LOST при входе в систему. Ставится в ~/Library/LaunchAgents/ (см. PORTING.md). -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.exrector.lost</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/open</string>
        <string>-a</string>
        <string>LOST_APP_PATH</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
